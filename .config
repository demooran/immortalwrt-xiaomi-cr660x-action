# --- إعدادات العتاد ---
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_xiaomi_mi-router-cr6608=y
CONFIG_TARGET_ramips_mt7621_DEVICE_xiaomi_mi-router-cr6609=y

# --- الحزم الأساسية ---
CONFIG_PACKAGE_adblock=y
CONFIG_PACKAGE_adbyby=y
CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE_coreutils-sort=y
CONFIG_PACKAGE_ipset=y
CONFIG_PACKAGE_kmod-nls-base=y
CONFIG_PACKAGE_kmod-nls-cp936=y
CONFIG_PACKAGE_kmod-oaf=y
CONFIG_PACKAGE_libipset=y
CONFIG_PACKAGE_libpcre=y
CONFIG_PACKAGE_librt=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_zlib=y
CONFIG_PACKAGE_luci-app-lldpd=y
CONFIG_PACKAGE_luci-app-watchcat=y

# --- واجهة LuCI (اللغة الإنجليزية فقط + ثيم Argon فقط) ---
CONFIG_PACKAGE_luci-app-accesscontrol=y
CONFIG_PACKAGE_luci-app-adblock=y
CONFIG_PACKAGE_luci-app-adbyby-plus=y
CONFIG_PACKAGE_luci-mod-dashboard=y
CONFIG_PACKAGE_luci-theme-argon=y

# --- اللغة الإنجليزية فقط ---
CONFIG_LUCI_LANG_en=y
# CONFIG_LUCI_LANG_zh_cn is not set
CONFIG_PACKAGE_luci-i18n-accesscontrol-en=y
CONFIG_PACKAGE_luci-i18n-adblock-en=y
CONFIG_PACKAGE_luci-i18n-adbyby-plus-en=y
CONFIG_PACKAGE_luci-base=y

# --- تسريع الشبكة (Hardware Offloading) ---
CONFIG_PACKAGE_kmod-nf-flow=y
CONFIG_PACKAGE_kmod-ipt-offload=y

# --- تعطيل توفير الطاقة (Power Saving) ---
# CONFIG_PACKAGE_irqbalance is not set
# CONFIG_PACKAGE_cpufreq is not set
# CONFIG_PACKAGE_cpufrequtils is not set
# CONFIG_PACKAGE_powertop is not set

# منع النواة من دعم تغيير تردد المعالج
# CONFIG_KERNEL_CPU_FREQ is not set
# CONFIG_KERNEL_CPU_FREQ_GOV_PERFORMANCE is not set
# CONFIG_KERNEL_CPU_FREQ_GOV_POWERSAVE is not set
# CONFIG_KERNEL_CPU_FREQ_GOV_ONDEMAND is not set
# CONFIG_KERNEL_CPU_FREQ_GOV_CONSERVATIVE is not set
# CONFIG_KERNEL_CPU_FREQ_GOV_SCHEDUTIL is not set

# --- إزالة الحزم غير الضرورية (لتوفير المساحة والذاكرة) ---
# CONFIG_PACKAGE_luci-app-appfilter is not set
# CONFIG_PACKAGE_luci-theme-bootstrap is not set
# CONFIG_PACKAGE_luci-theme-material is not set
# CONFIG_PACKAGE_luci-theme-openwrt is not set
# CONFIG_PACKAGE_luci-theme-openwrt-2020 is not set
