# --- إعدادات العتاد ---
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
# CONFIG_TARGET_ramips_mt7621_DEVICE_xiaomi_mi-router-cr6608 is not set
CONFIG_TARGET_ramips_mt7621_DEVICE_xiaomi_mi-router-cr6609=y

# --- الحزم الأساسية والخدمات المطلوبة ---
CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE_coreutils-sort=y
CONFIG_PACKAGE_ipset=y
CONFIG_PACKAGE_kmod-nls-base=y
CONFIG_PACKAGE_kmod-nls-cp936=y
CONFIG_PACKAGE_libipset=y
CONFIG_PACKAGE_libpcre=y
CONFIG_PACKAGE_librt=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_zlib=y
CONFIG_PACKAGE_luci-app-lldpd=y
CONFIG_PACKAGE_luci-app-watchcat=y
CONFIG_PACKAGE_openssh-sftp-server=y

# ضبط wpad-mbedtls ومنع تعارضات wpad-basic-wolfssl و hostapd-common
CONFIG_PACKAGE_wpad-mbedtls=y
# CONFIG_PACKAGE_wpad-basic is not set
# CONFIG_PACKAGE_wpad-basic-wolfssl is not set
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set
# CONFIG_PACKAGE_wpad-mini is not set
# CONFIG_PACKAGE_wpad-mesh-wolfssl is not set
# CONFIG_PACKAGE_wpad-mesh-mbedtls is not set

# --- أدوات الشبكة وVLAN والجسور ---
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_kmod-8021q=y
CONFIG_PACKAGE_kmod-br-netfilter=y
CONFIG_PACKAGE_ethtool=y

# --- تفعيل واجهة LuCI والخدمات الأساسية للـ Web ---
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_rpcd=y
CONFIG_PACKAGE_rpcd-mod-uci=y
CONFIG_PACKAGE_rpcd-mod-sys=y
CONFIG_PACKAGE_libiwinfo-lua=y
CONFIG_PACKAGE_luci-lib-ip=y
CONFIG_PACKAGE_luci-lib-jsonc=y
CONFIG_PACKAGE_luci-lib-nixio=y

# --- واجهة LuCI (اللغة الإنجليزية والعربية + ثيم Argon وتخصيصات diy-part2.sh) ---
# CONFIG_PACKAGE_luci-theme-argon is not set
# CONFIG_PACKAGE_luci-app-argon-config is not set
CONFIG_LUCI_LANG_en=y
CONFIG_PACKAGE_luci-i18n-base-ar=y
# CONFIG_LUCI_LANG_zh_cn is not set

# --- تسريع الشبكة (Hardware Offloading) ---
CONFIG_PACKAGE_kmod-nf-flow=y
CONFIG_PACKAGE_kmod-ipt-offload=y

# --- تعطيل توفير الطاقة (Power Saving) ---
# CONFIG_PACKAGE_irqbalance is not set
# CONFIG_PACKAGE_cpufreq is not set
# CONFIG_PACKAGE_cpufrequtils is not set
# CONFIG_PACKAGE_powertop is not set

# منع النواة من دعم تغيير تردد المعالج
# CONFIG_KERNEL_CPU_FREQ is not set
# CONFIG_KERNEL_CPU_FREQ_GOV_PERFORMANCE is not set
# CONFIG_KERNEL_CPU_FREQ_GOV_POWERSAVE is not set
# CONFIG_KERNEL_CPU_FREQ_GOV_ONDEMAND is not set
# CONFIG_KERNEL_CPU_FREQ_GOV_CONSERVATIVE is not set
# CONFIG_KERNEL_CPU_FREQ_GOV_SCHEDUTIL is not set

# --- إزالة الخدمات والحزم والثيمات غير الضرورية تماماً ---
# CONFIG_PACKAGE_luci-app-accesscontrol is not set
# CONFIG_PACKAGE_luci-app-adblock is not set
# CONFIG_PACKAGE_luci-app-adbyby-plus is not set
# CONFIG_PACKAGE_luci-app-appfilter is not set
# CONFIG_PACKAGE_luci-theme-material is not set
# CONFIG_PACKAGE_luci-theme-openwrt is not set
# CONFIG_PACKAGE_luci-theme-openwrt-2020 is not set
